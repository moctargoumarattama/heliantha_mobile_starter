APP_NAME=Heliantha Mobile API
APP_ENV=development
API_PREFIX=/v1

PRESTASHOP_BASE_URL=https://heliantha.ma
PRESTASHOP_WEBSERVICE_KEY=CHANGE_ME
PRESTASHOP_LANGUAGE_ID=1
PRESTASHOP_TIMEOUT_SECONDS=20

JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Optionnel : pont serveur installé dans PrestaShop pour login/checkout.
MOBILE_BRIDGE_URL=
MOBILE_BRIDGE_SECRET=

# Séparer par des virgules.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
